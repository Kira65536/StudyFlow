
# Адрес базы данных (Docker Compose задаёт внутренний адрес автоматически)
DATABASE_URL=

# Секретный ключ для подписи JWT-токенов
JWT_SECRET=замените-на-длинный-случайный-секрет

# Токен собственного Telegram-бота, полученный через @BotFather
TELEGRAM_BOT_TOKEN=

# Необязательный прокси для подключения к Telegram
# Пример: http://127.0.0.1:10808
# Оставьте пустым, если прокси не требуется
TELEGRAM_PROXY=
